<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rule: every user sees only their own shortcuts.
         Administrators are NOT exempted from this rule. -->
    <record id="rule_personal_app_shortcut_own" model="ir.rule">
        <field name="name">Personal App Shortcut: own records only</field>
        <field name="model_id" ref="model_personal_app_shortcut"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
